{
  "name": "nametempest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:server": "node --watch server/main.ts",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "start": "node server/main.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/",
    "test:integration": "node --test tests/integration/",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
