{
  "name": "nametempest",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --watch server/main.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
