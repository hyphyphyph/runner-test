    "test": "NODE_ENV=test node --test tests/",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=24"
  }
}
