use @piton/belay
use @piton/config

from @piton/belay import ClaudeCodeAdapter

export piton-config Project:
    root: ./spec
    entry: ./spec/index.pi

    frameworks:
        - {Belay}

    dependencies:
        - https://github.com/piton-lang/crux.git

belay-config Belay:
    codeRoot: .

    adapters:
        - {ClaudeCodeAdapter}
